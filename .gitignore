# ===== 敏感信息保护 =====
# SSH 私钥 / API Key / 配置文件中的密码
*.pem
*.key
*.ppk
.env
.env.*
secrets/
*.secret

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 日志 =====
*.log
logs/

# ===== 临时文件 =====
tmp/
temp/
*.tmp

# ===== Node.js（如果后续加前端） =====
node_modules/
package-lock.json

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 部署产物 =====
dist/
build/
*.tar.gz
*.zip
